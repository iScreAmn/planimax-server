generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  admin
}

enum UserStatus {
  pending
  approved
  rejected
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  name         String     @db.VarChar(60)
  passwordHash String     @map("password_hash")
  role         Role       @default(user)
  status       UserStatus @default(pending)

  reviewedAt        DateTime? @map("reviewed_at")
  passwordUpdatedAt DateTime  @default(now()) @map("password_updated_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  projects      Project[]
  tasks         Task[]

  @@index([status])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @default(dbgenerated("gen_random_uuid()")) @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  rotatedAt DateTime? @map("rotated_at")
  userAgent String?   @map("user_agent")
  ip        String?
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Project {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  name         String   @db.VarChar(30)
  color        String   @db.VarChar(7)
  notes        String   @default("")
  notesDoc     String?  @map("notes_doc")
  notesVersion Int      @default(0) @map("notes_version")
  inPlanner    Boolean  @default(false) @map("in_planner")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user  User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([userId])
  @@map("projects")
}

enum TaskStatus {
  todo
  done
}

enum TaskPriority {
  low
  normal
  high
}

enum ReminderStatus {
  scheduled
  sending
  sent
  failed
  canceled
}

model Task {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  projectId   String?      @map("project_id") @db.Uuid
  title       String       @db.VarChar(200)
  date        DateTime?    @db.Date
  time        String?      @db.VarChar(5)
  priority    TaskPriority @default(normal)
  status      TaskStatus   @default(todo)
  position    Int          @default(0)
  isCurrent   Boolean      @default(false) @map("is_current")
  completedAt DateTime?    @map("completed_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  reminderAt            DateTime?       @map("reminder_at")
  reminderTimezone      String?         @map("reminder_timezone") @db.VarChar(64)
  reminderStatus        ReminderStatus? @map("reminder_status")
  reminderNextAttemptAt DateTime?       @map("reminder_next_attempt_at")
  reminderClaimedAt     DateTime?       @map("reminder_claimed_at")
  reminderAttempts      Int             @default(0) @map("reminder_attempts")
  reminderSentAt        DateTime?       @map("reminder_sent_at")
  reminderLastError     String?         @map("reminder_last_error") @db.VarChar(500)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([projectId])
  @@index([reminderStatus, reminderNextAttemptAt])
  @@map("tasks")
}
